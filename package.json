{
  "name": "onlystory",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare": "node scripts/setup-live2d.mjs",
    "predev": "node scripts/setup-live2d.mjs",
    "prebuild": "node scripts/setup-live2d.mjs",
    "setup:live2d": "node scripts/setup-live2d.mjs",
    "import:gfl2": "node scripts/import-gfl2.mjs",
    "import:gfl1": "node scripts/import-gfl1.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "node scripts/library-server.mjs",
    "storage:audit": "python scripts/storage-audit.py",
    "storage:images": "python scripts/storage-images.py",
    "test": "vitest run",
    "test:import": "node --test scripts/gfl1-story.test.mjs scripts/gfl1-interactions.test.mjs scripts/gfl1-branch-joins.test.mjs scripts/gfl2-event.test.mjs scripts/gfl2-scenes.test.mjs scripts/gfl2-ilion.test.mjs scripts/gfl2-branches.test.mjs scripts/storage-library.test.mjs scripts/library-server.test.mjs",
    "test:browser": "playwright test",
    "audit:cg": "node scripts/audit-gfl2-cg.mjs",
    "verify": "npm run test && npm run build && npm run test:import && npm run test:browser",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tanstack/react-virtual": "3.14.19",
    "lucide-react": "1.57.0",
    "pixi-live2d-display": "0.4.0",
    "pixi.js": "6.5.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "overrides": {
    "gh-pages": "6.1.1"
  }
}
